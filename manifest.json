{
  "manifest_version": 3,
  "name": "Colonist 1v1 Recorder",
  "version": "0.1.0",
  "description": "Passively records your own Colonist.io games (network frames and game log) for offline post-game analysis.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://colonist.io/*",
    "*://*.colonist.io/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Colonist Recorder",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://colonist.io/*",
        "*://*.colonist.io/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://colonist.io/*",
        "*://*.colonist.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "colonist-recorder@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
